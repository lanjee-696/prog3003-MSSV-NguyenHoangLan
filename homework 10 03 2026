import { useState } from "react";

export default function TempConverter() {
  const [celsius, setCelsius] = useState("");
  const [fahrenheit, setFahrenheit] = useState(null);

  const convert = () => {
    const f = parseFloat(celsius) * 9 / 5 + 32;
    setFahrenheit(f);
  };

  return (
    <div style={{ padding: 20, fontFamily: "Arial" }}>
      <h2>Chuyển đổi nhiệt độ °C → °F</h2>

      <input
        type="number"
        value={celsius}
        onChange={(e) => setCelsius(e.target.value)}
        placeholder="Nhập nhiệt độ (°C)"
        style={{ padding: 8, fontSize: 16, marginRight: 10 }}
      />

      <button onClick={convert} style={{ padding: "8px 16px", fontSize: 16 }}>
        Chuyển đổi
      </button>

      {fahrenheit !== null && (
        <p style={{ marginTop: 16, fontSize: 18 }}>
          Kết quả: <strong>{fahrenheit.toFixed(2)} °F</strong>
        </p>
      )}
    </div>
  );
}
 
