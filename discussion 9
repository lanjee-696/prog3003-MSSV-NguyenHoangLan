import java.util.ArrayList;
import java.util.ArrayList;
import java.util.ArrayList;

public class StudentFrame extends JFrame {
    private JTextField txtMSSV, txtTen, txtGPA;
    private JButton btnThem, btnXem, btnTimKiem, btnXoa;
    private JTable table;
    private DefaultTableModel model;
    private ArrayList<Student> students = new ArrayList<>();

    public StudentFrame() {
        setTitle("Quản Lý Sinh Viên");
        setSize(700, 500);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        
        JPanel pnInput = new JPanel();
        pnInput.add(new JLabel("MSSV:"));
        txtMSSV = new JTextField(10);
        pnInput.add(txtMSSV);
        
        pnInput.add(new JLabel("Tên:"));
        txtTen = new JTextField(15);
        pnInput.add(txtTen);
        
        pnInput.add(new JLabel("GPA:"));
        txtGPA = new JTextField(8);
        pnInput.add(txtGPA);
        
        btnThem = new JButton("Thêm");
        btnThem.addActionListener(e -> themSV());
        pnInput.add(btnThem);
        
        btnXem = new JButton("Xem");
        btnXem.addActionListener(e -> xemDS());
        pnInput.add(btnXem);
        
        btnTimKiem = new JButton("Tìm");
        btnTimKiem.addActionListener(e -> timKiem());
        pnInput.add(btnTimKiem);
        
        btnXoa = new JButton("Xóa");
        btnXoa.addActionListener(e -> xoaSV());
        pnInput.add(btnXoa);
        
        model = new DefaultTableModel(new String[]{"MSSV", "Tên", "GPA"}, 0);
        table = new JTable(model);
        JScrollPane scroll = new JScrollPane(table);
        
        add(pnInput, "North");
        add(scroll, "Center");
        
        loadData();
    }

    private void themSV() {
        try {
            String mssv = txtMSSV.getText().trim();
            String ten = txtTen.getText().trim();
            double gpa = Double.parseDouble(txtGPA.getText().trim());
            
            if (mssv.isEmpty() || ten.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Điền đầy đủ thông tin");
                return;
            }
            
            for (Student s : students) {
                if (s.mssv.equals(mssv)) {
                    JOptionPane.showMessageDialog(this, "MSSV đã tồn tại");
                    return;
                }
            }
            
            students.add(new Student(mssv, ten, gpa));
            JOptionPane.showMessageDialog(this, "Thêm thành công");
            txtMSSV.setText("");
            txtTen.setText("");
            txtGPA.setText("");
            xemDS();
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Lỗi: " + e.getMessage());
        }
    }

    private void xemDS() {
        model.setRowCount(0);
        for (Student s : students) {
            model.addRow(new Object[]{s.mssv, s.ten, s.gpa});
        }
    }

    private void timKiem() {
        String ten = JOptionPane.showInputDialog(this, "Nhập tên:");
        if (ten == null) return;
        
        model.setRowCount(0);
        for (Student s : students) {
            if (s.ten.toLowerCase().contains(ten.toLowerCase())) {
                model.addRow(new Object[]{s.mssv, s.ten, s.gpa});
            }
        }
    }

    private void xoaSV() {
        String mssv = JOptionPane.showInputDialog(this, "Nhập MSSV cần xóa:");
        if (mssv == null) return;
        
        for (int i = 0; i < students.size(); i++) {
            if (students.get(i).mssv.equals(mssv)) {
                students.remove(i);
                JOptionPane.showMessageDialog(this, "Xóa thành công");
                xemDS();
                return;
            }
        }
        JOptionPane.showMessageDialog(this, "Không tìm thấy");
    }

    private void loadData() {
        students.add(new Student("SV001", "Nguyễn lanjee ", 3.8));
        students.add(new Student("SV002", "Nguyễn Skibidi", 3.5));
        xemDS();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new StudentFrame().setVisible(true));
    }
}

class Student {
    String mssv, ten;
    double gpa;
    
    Student(String mssv, String ten, double gpa) {
        this.mssv = mssv;
        this.ten = ten;
        this.gpa = gpa;
    }
}

