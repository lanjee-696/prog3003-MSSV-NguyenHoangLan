import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.util.ArrayList;

public class BankingFrame extends JFrame {
    private JComboBox<String> cboFrom, cboTo;
    private JTextField txtAmount;
    private JPasswordField txtPIN;
    private JTextArea txtLog;
    private DefaultTableModel model;
    private ArrayList<Account> accounts = new ArrayList<>();

    public BankingFrame() {
        setTitle("Hệ Thống Ngân Hàng");
        setSize(700, 600);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        
        JPanel pnLeft = new JPanel();
        pnLeft.setLayout(new BoxLayout(pnLeft, BoxLayout.Y_AXIS));
        
        pnLeft.add(new JLabel("TK gửi:"));
        cboFrom = new JComboBox<>();
        pnLeft.add(cboFrom);
        
        pnLeft.add(new JLabel("TK nhận:"));
        cboTo = new JComboBox<>();
        pnLeft.add(cboTo);
        
        pnLeft.add(new JLabel("Số tiền:"));
        txtAmount = new JTextField("1000000", 15);
        pnLeft.add(txtAmount);
        
        pnLeft.add(new JLabel("PIN:"));
        txtPIN = new JPasswordField("1234", 15);
        pnLeft.add(txtPIN);
        
        JButton btnTransfer = new JButton("Chuyển Tiền");
        btnTransfer.addActionListener(e -> chuyenTien());
        pnLeft.add(btnTransfer);
        
        JPanel pnRight = new JPanel();
        pnRight.setLayout(new BoxLayout(pnRight, BoxLayout.Y_AXIS));
        
        model = new DefaultTableModel(new String[]{"Mã TK", "Chủ TK", "Số Dư"}, 0);
        JTable table = new JTable(model);
        JScrollPane scroll1 = new JScrollPane(table);
        pnRight.add(new JLabel("Tài Khoản:"));
        pnRight.add(scroll1);
        
        txtLog = new JTextArea(10, 40);
        txtLog.setEditable(false);
        JScrollPane scroll2 = new JScrollPane(txtLog);
        pnRight.add(new JLabel("Nhật Ký:"));
        pnRight.add(scroll2);
        
        add(pnLeft, "West");
        add(pnRight, "Center");
        
        loadAccounts();
    }

    private void loadAccounts() {
        accounts.clear();
        accounts.add(new Account("ACC001", "Nguyễn Văn A", 5000000));
        accounts.add(new Account("ACC002", "Trần Thị B", 2000000));
        accounts.add(new Account("ACC003", "Lê Văn C", 1000000));
        
        cboFrom.removeAllItems();
        cboTo.removeAllItems();
        
        model.setRowCount(0);
        
        for (Account acc : accounts) {
            cboFrom.addItem(acc.id + " - " + acc.holder);
            cboTo.addItem(acc.id + " - " + acc.holder);
            model.addRow(new Object[]{acc.id, acc.holder, acc.balance});
        }
    }

    private void chuyenTien() {
        try {
            int fromIdx = cboFrom.getSelectedIndex();
            int toIdx = cboTo.getSelectedIndex();
            
            if (fromIdx == toIdx) {
                JOptionPane.showMessageDialog(this, "Không thể chuyển cho chính mình");
                return;
            }
            
            String pin = new String(txtPIN.getPassword());
            double amount = Double.parseDouble(txtAmount.getText().trim());
            
            if (!pin.equals("1234")) {
                txtLog.setText("❌ PIN sai");
                return;
            }
            
            Account from = accounts.get(fromIdx);
            Account to = accounts.get(toIdx);
            
            if (from.balance < amount) {
                txtLog.setText("❌ Số dư không đủ");
                return;
            }
            
            from.balance -= amount;
            to.balance += amount;
            
            String log = "🔐 Xác thực: OK\n" +
                        "💰 Kiểm tra số dư: OK\n" +
                        "🔄 Chuyển " + String.format("%.0f", amount) + " từ " + from.id + " sang " + to.id + "\n" +
                        "✅ Giao dịch thành công";
            txtLog.setText(log);
            
            loadAccounts();
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Lỗi: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new BankingFrame().setVisible(true));
    }
}

class Account {
    String id, holder;
    double balance;
    
    Account(String id, String holder, double balance) {
        this.id = id;
        this.holder = holder;
        this.balance = balance;
    }
}
