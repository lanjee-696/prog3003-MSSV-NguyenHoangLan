import javax.swing.*;

public class PaymentFrame extends JFrame {
    private JComboBox<String> cboMethod;
    private JTextField txtAmount;
    private JTextArea txtOutput;

    public PaymentFrame() {
        setTitle("Hệ Thống Thanh Toán");
        setSize(600, 400);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        
        JPanel pnTop = new JPanel();
        pnTop.add(new JLabel("Chọn phương thức:"));
        cboMethod = new JComboBox<>(new String[]{"Credit Card", "PayPal", "Cash"});
        pnTop.add(cboMethod);
        
        pnTop.add(new JLabel("Số tiền:"));
        txtAmount = new JTextField(10);
        txtAmount.setText("1000000");
        pnTop.add(txtAmount);
        
        JButton btnPay = new JButton("Thanh Toán");
        btnPay.addActionListener(e -> thanhToan());
        pnTop.add(btnPay);
        
        txtOutput = new JTextArea(15, 50);
        txtOutput.setEditable(false);
        JScrollPane scroll = new JScrollPane(txtOutput);
        
        add(pnTop, "North");
        add(scroll, "Center");
    }

    private void thanhToan() {
        try {
            String method = (String) cboMethod.getSelectedItem();
            double amount = Double.parseDouble(txtAmount.getText().trim());
            
            if (amount <= 0) {
                JOptionPane.showMessageDialog(this, "Số tiền phải lớn hơn 0");
                return;
            }
            
            String output = "";
            if ("Credit Card".equals(method)) {
                output = "THANH TOÁN BẰNG THẺ TÍN DỤNG\n" +
                        "Số thẻ: ****3456\n" +
                        "Chủ thẻ: Nguyễn Văn A\n" +
                        "Số tiền: " + String.format("%.2f", amount) + " VND\n" +
                        "✅ Thanh toán thành công";
            } else if ("PayPal".equals(method)) {
                output = "THANH TOÁN QURA PAYPAL\n" +
                        "Email: user@example.com\n" +
                        "Số tiền: " + String.format("%.2f", amount) + " VND\n" +
                        "✅ Thanh toán thành công";
            } else {
                output = "THANH TOÁN BẰNG TIỀN MẶT\n" +
                        "Địa điểm: Cửa hàng chính\n" +
                        "Số tiền: " + String.format("%.2f", amount) + " VND\n" +
                        "✅ Thanh toán thành công";
            }
            
            txtOutput.setText(output);
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Lỗi: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new PaymentFrame().setVisible(true));
    }
}



