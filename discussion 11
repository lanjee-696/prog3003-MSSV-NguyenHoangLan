public class Bai1_GenericMethod {
    public static <E> void printArray(E[] array) {
        System.out.println("Danh sách phần tử:");
        for (E element : array) {
            System.out.print(element + " ");
        }
        System.out.println("\n");
    }
    
    public static void main(String[] args) {
        System.out.println("===== GENERIC METHOD - IN MẢNG =====\n");

        System.out.println("Test 1: In mảng Integer[]");
        Integer[] intArray = {10, 20, 30, 40, 50};
        printArray(intArray);

        System.out.println("Test 2: In mảng String[]");
        String[] stringArray = {"Java", "Python", "C++", "JavaScript"};
        printArray(stringArray);
    }
}



